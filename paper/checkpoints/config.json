  "learning_rate": 0.0003,
  "grad_norm_clip": 10.0,
  "weight_decay": 0.01,
  "lr_warmup_steps": 2000,
  "use_cosine_decay": true,
  "lr_min": 1e-05,
  "load_dir": null
